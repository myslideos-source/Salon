NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# Optional second Voice-AI provider (see lib/voice/providers/elevenlabs.ts),
# synced and tested in parallel to Retell from the admin AI settings page.
# ELEVENLABS_WEBHOOK_SECRET is any random string you also put in the
# webhook tool config on ElevenLabs' side (own shared secret, not their
# signing scheme).
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

APP_URL=http://localhost:3000

# Any random string; protects /api/cron/resync-voice-agents. Vercel sends
# this automatically as "Authorization: Bearer <value>" for its own Cron
# Jobs once this variable exists in the project (see vercel.json).
CRON_SECRET=

# Twilio. Zwei unabhängige Verwendungen teilen sich dieselben Zugangsdaten:
# (1) SMS-Terminbestätigung (lib/sms/providers/twilio.ts) - ohne diese Werte
#     wird einfach keine SMS verschickt, alles andere funktioniert weiter.
#     Für die Anmeldung entweder TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET
#     (empfohlen, wird zuerst versucht) ODER TWILIO_AUTH_TOKEN - nicht beides.
# (2) Optionaler dritter Telefonie-Provider für eingehende Anrufe
#     (lib/voice/providers/twilio.ts), als Alternative zu Retell/ElevenLabs
#     - siehe admin Salon-Seite "KI". Braucht zwingend TWILIO_ACCOUNT_SID +
#     TWILIO_AUTH_TOKEN (Signaturprüfung eingehender Webhooks funktioniert
#     nur mit dem echten Auth Token, nicht mit einem API Key).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional later
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
