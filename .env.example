NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# Any random string; protects /api/cron/resync-voice-agents. Vercel sends
# this automatically as "Authorization: Bearer <value>" for its own Cron
# Jobs once this variable exists in the project (see vercel.json).
CRON_SECRET=

# SMS-Terminbestätigung (Twilio). Ohne diese drei Werte wird einfach keine
# SMS verschickt - alles andere funktioniert weiter normal.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional later
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
